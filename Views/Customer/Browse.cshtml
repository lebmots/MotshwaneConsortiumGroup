@model IEnumerable<ServiceItem>
@{ ViewData["Title"]="Browse Services"; }<h1>Browse Freezers & Toilets</h1><div class="filters"><a class="filter" href="/Customer/Browse">All</a><a class="filter" href="/Customer/Browse?category=Freezer">Freezers</a><a class="filter" href="/Customer/Browse?category=Toilet">Toilets</a></div><div class="grid three">@foreach(var item in Model){<div class="card"><span class="pill">@item.Category</span><h3>@item.Name</h3><p>@item.Description</p><div class="price">From R @item.PriceFrom.ToString("N0")</div><p class="availability @(item.Available ? "available" : "unavailable")">@(item.Available ? "Available" : "Unavailable")</p>@if(item.Available){<a class="btn small" href="/Customer/Booking">Book Service</a>}</div>}</div>
