@{ ViewData["Title"]="Login"; }<div class="form-page narrow"><h1>Sign In</h1>@if(!ViewData.ModelState.IsValid){<div class="alert error">@Html.ValidationSummary()</div>}<form method="post" class="formcard">@Html.AntiForgeryToken()<label>Email<input type="email" name="email" required /></label><label>Password<input type="password" name="password" required /></label><button class="btn full" type="submit">Sign In</button></form>

<p class="text-center mt-3">
    Don't have an account?
    <a asp-controller="Customer"
       asp-action="Register"
       class="fw-semibold">
        Create an account
    </a>
</p>



<p class="muted center"> </p></div>
