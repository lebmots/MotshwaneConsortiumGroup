@{ ViewData["Title"]="Upload Proof"; }<div class="form-page"><h1>Upload Proof of Payment</h1>@if(!ViewData.ModelState.IsValid){<div class="alert error">@Html.ValidationSummary()</div>}<form method="post" enctype="multipart/form-data" class="formcard">@Html.AntiForgeryToken()<label>Booking Reference<input name="reference" required /></label><label>Payment Proof<input type="file" name="proof" accept=".pdf,.jpg,.jpeg,.png" required /></label><div class="notice"> </div><button class="btn" type="submit">Submit Proof</button></form></div>
