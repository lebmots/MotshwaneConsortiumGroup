@using MotshwaneConsortiumGroup.Models

@{
    ViewData["Title"] = "Booking";
    var units = ViewBag.Units as IEnumerable<Unit>
        ?? Enumerable.Empty<Unit>();
}

<div class="form-page">

    <h1>Booking Form</h1>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert error">
            @Html.ValidationSummary()
        </div>
    }

    <form method="post" class="formcard">

        @Html.AntiForgeryToken()

        <div class="form-grid">

            <label class="wide">
                Service / Unit

                <select name="unitId" required>

                    <option value="">
                        Choose a service
                    </option>

                    @foreach (var unit in units)
                    {
                        <option value="@unit.Id">
                            @unit.Name -
                            @unit.Category -
                            R @unit.PriceFrom.ToString("N0")
                        </option>
                    }

                </select>

            </label>

            <label>
                Booking Date

                <input type="date"
                       name="date"
                       required
                       min="@DateTime.Today.ToString("yyyy-MM-dd")" />

            </label>

            <label>
                Location

                <input name="location"
                       required
                       maxlength="250" />

            </label>

            <label class="wide">
                Additional Notes

                <textarea name="notes"
                          rows="4"></textarea>

            </label>

        </div>

        <button class="btn" type="submit">
            Submit Booking
        </button>

    </form>

</div>