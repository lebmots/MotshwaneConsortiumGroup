@{ ViewData["Title"]="Booking"; }<div class="form-page"><h1>Booking Form</h1>@if(!ViewData.ModelState.IsValid){<div class="alert error">@Html.ValidationSummary()</div>}<form method="post" class="formcard">@Html.AntiForgeryToken()<div class="form-grid"><label>Full Name<input name="name" required /></label><label>Service<select name="service" required><option value="">Choose a service</option><option>Mobile Freezer</option><option>Mobile Toilet</option></select></label><label>Booking Date<input type="date" name="date" required min="@DateTime.Today.ToString("yyyy-MM-dd")" /></label><label>Location<input name="location" required /></label><label class="wide">Additional Notes<textarea name="notes" rows="4"></textarea></label></div><button class="btn" type="submit">Submit Booking</button></form></div>
