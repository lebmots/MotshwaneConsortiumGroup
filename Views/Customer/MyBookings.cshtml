@model IEnumerable<MotshwaneConsortiumGroup.Models.Booking>

@{
    ViewData["Title"] = "My Bookings";
}

<h1>My Bookings</h1>

<div class="table-wrap">

    <table>

        <thead>
            <tr>
                <th>Reference</th>
                <th>Service</th>
                <th>Date</th>
                <th>Location</th>
                <th>Status</th>
                <th>Payment</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var b in Model)
                {
                    <tr>
                        <td>
                            <strong>@b.Reference</strong>
                        </td>

                        <td>
                            @(b.Unit?.Category ?? "N/A")
                        </td>

                        <td>
                            @b.BookingDate.ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @b.Location
                        </td>

                        <td>
                            <span class="status">
                                @b.Status
                            </span>
                        </td>

                        <td>
                            @b.PaymentStatus
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6">
                        No bookings found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>