@{ ViewData["Title"]="Register"; }<div class="form-page"><h1>Create an Account</h1>@if(!ViewData.ModelState.IsValid){<div class="alert error">@Html.ValidationSummary()</div>}<form method="post" class="formcard">@Html.AntiForgeryToken()<div class="form-grid"><label>Full Name<input name="name" required maxlength="80" /></label><label>Phone<input name="phone" required maxlength="20" /></label><label class="wide">Email<input type="email" name="email" required /></label><label class="wide">Password<input type="password" name="password" minlength="8" required /></label></div><button class="btn" type="submit">Create Account</button></form></div>
