@model IEnumerable<StaffJob>
@{ ViewData["Title"]="Assigned Jobs"; }<h1>Assigned Jobs</h1><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Service</th><th>Location</th><th>Date</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var j in Model){<tr><td>@j.Booking.Reference</td><td>@j.Booking.Unit.Category</td><td>@j.Booking.Location</td><td>@j.Booking.BookingDate.ToString("dd MMM yyyy")</td><td>@j.Status</td><td><a href="/Staff/JobDetails?id=@j.Id">Details</a></td></tr>}</tbody></table></div>
