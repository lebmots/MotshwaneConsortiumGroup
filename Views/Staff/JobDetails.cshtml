@model StaffJob
@{ ViewData["Title"]="Job Details"; }<div class="page-head"><div><h1>Job @Model.Booking.Reference</h1></div><a class="btn" href="/Staff/UpdateStatus?id=@Model.Id">Update Status</a></div><div class="grid two"><div class="card"><h3>Service</h3><p>@Model.Booking.Unit.Category</p></div><div class="card"><h3>Location</h3><p>@Model.Booking.Location</p></div><div class="card"><h3>Date</h3><p>@Model.Booking.BookingDate.ToString("dd MMMM yyyy")</p></div><div class="card"><h3>Status</h3><p>@Model.Status</p></div></div>
