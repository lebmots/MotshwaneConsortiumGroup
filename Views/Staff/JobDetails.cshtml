@model StaffJob
@{ ViewData["Title"]="Job Details"; }<div class="page-head"><div><h1>Job @Model.Reference</h1></div><a class="btn" href="/Staff/UpdateStatus?id=@Model.Id">Update Status</a></div><div class="grid two"><div class="card"><h3>Service</h3><p>@Model.Service</p></div><div class="card"><h3>Location</h3><p>@Model.Location</p></div><div class="card"><h3>Date</h3><p>@Model.Date.ToString("dd MMMM yyyy")</p></div><div class="card"><h3>Status</h3><p>@Model.Status</p></div></div>
