@model IEnumerable<StaffJob>
@{ ViewData["Title"]="Staff Dashboard"; }<h1>Staff Dashboard</h1><div class="stats"><div class="stat"><strong>@Model.Count()</strong><span>Assigned Jobs</span></div><div class="stat"><strong>@Model.Count(x=>x.Status=="In Progress")</strong><span>In Progress</span></div></div><div class="grid two">@foreach(var j in Model){<div class="card"><span class="pill">@j.Reference</span><h3>@j.Service</h3><p>@j.Location · @j.Date.ToString("dd MMM yyyy")</p><span class="status">@j.Status</span><p><a class="btn small" href="/Staff/JobDetails?id=@j.Id">View Job</a></p></div>}</div>
