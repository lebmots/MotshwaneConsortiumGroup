@model IEnumerable<Booking>
@{ ViewData["Title"] = "Reports"; }<h1>Reports</h1> <div class="stats"> <!-- Total Bookings --> <div class="stat"> <strong>@Model.Count()</strong> <span>Bookings</span> </div> <!-- Freezer Requests --> <div class="stat"> <strong> @Model.Count(x => x.Unit != null && x.Unit.Category.Contains("Freezer")) </strong> <span>Freezer Requests</span> </div> <!-- Toilet Requests --> <div class="stat"> <strong> @Model.Count(x => x.Unit != null && x.Unit.Category.Contains("Toilet")) </strong> <span>Toilet Requests</span> </div> </div>