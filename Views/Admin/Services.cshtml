@model IEnumerable<MotshwaneConsortiumGroup.Models.Unit>

@{
    ViewData["Title"] = "Manage Services";
}

<h1>Manage Freezers & Toilets</h1>

<div class="grid three">

    @foreach (var unit in Model)
    {
        <div class="card">

            <span class="pill">
                @unit.Category
            </span>

            <h3>
                @unit.Name
            </h3>

            <p>
                @unit.Description
            </p>

            <strong>
                From R @unit.PriceFrom.ToString("N0")
            </strong>

            <p>
                @(unit.Available ? "Available" : "Unavailable")
            </p>

        </div>
    }

</div>