@model IEnumerable<Unit>
@{
    ViewData["Title"] = "Services";
}
<h1>Manage Services</h1>
<div class="table-wrap"><table><thead><tr><th>Name</th><th>Category</th><th>Description</th><th>Price From</th><th>Available</th></tr></thead><tbody>@foreach(var s in Model){
    <tr><td>@s.Name</td><td>@s.Category</td><td>@s.Description</td><td>R @s.PriceFrom.ToString("N0")</td><td>@(s.Available ? "Yes" : "No")</td></tr>
}
</tbody></table></div>
