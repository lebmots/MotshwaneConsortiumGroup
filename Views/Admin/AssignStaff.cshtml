@model IEnumerable<Booking>
@{ ViewData["Title"]="Assign Staff"; }<h1>Assign Staff</h1><div class="grid three">@foreach(var b in Model){<div class="card"><span class="pill">@b.Reference</span><h3>@b.Service</h3><p>@b.Location · @b.BookingDate.ToString("dd MMM yyyy")</p><select><option>Select Staff Member</option><option>Staff Member 1</option><option>Staff Member 2</option></select><button class="btn small" type="button">Assign</button></div>}</div>
