@model IEnumerable<Booking>
@{ ViewData["Title"]="Payments"; }<h1>Manage Payments</h1>
@if(TempData["Message"] != null){<div class="alert">@TempData["Message"]</div>}
@if(TempData["Error"] != null){<div class="alert error">@TempData["Error"]</div>}
<div class="table-wrap"><table><thead><tr><th>Reference</th><th>Customer</th><th>Payment Status</th><th>Booking Status</th><th>Action</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.Reference</td><td>@b.CustomerName</td><td>@b.PaymentStatus</td><td>@b.Status</td><td>
@if(b.PaymentStatus == "Proof Submitted"){
<form method="post" asp-action="ApprovePayment" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="bookingId" value="@b.Id" /><button class="btn small" type="submit">Approve</button></form>
<form method="post" asp-action="RejectPayment" style="display:inline">@Html.AntiForgeryToken()<input type="hidden" name="bookingId" value="@b.Id" /><input type="text" name="reason" placeholder="Reason" required /><button class="btn small" type="submit">Reject</button></form>
}
</td></tr>}</tbody></table></div>
