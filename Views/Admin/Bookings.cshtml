@model IEnumerable<MotshwaneConsortiumGroup.Models.Booking>
@{
    ViewData["Title"] = "Manage Bookings";
}

<h1>Manage Bookings</h1>

<div class="table-wrap">

    <table>

        <thead>
            <tr>
                <th>Reference</th>
                <th>Customer</th>
                <th>Service</th>
                <th>Date</th>
                <th>Location</th>
                <th>Status</th>
                <th>Payment</th>
            </tr>
        </thead>

        <tbody>

            @if (Model != null && Model.Any())
            {
                foreach (var b in Model)
                {
                    <tr>

                        <td>
                            <strong>
                                @(b.Reference ?? "N/A")
                            </strong>
                        </td>

                        <td>
                            @(b.Customer?.User?.FullName ?? "Unknown Customer")
                        </td>

                        <td>
                            @(b.Unit?.Category ?? "Unknown Service")
                        </td>

                        <td>
                            @b.BookingDate.ToString("dd MMM yyyy")
                        </td>

                        <td>
                            @(b.Location ?? "No location")
                        </td>

                        <td>
                            <span class="status">
                                @(b.Status ?? "Unknown")
                            </span>
                        </td>

                        <td>
                            @(b.PaymentStatus ?? "Unknown")
                        </td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">
                        No bookings found.
                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>