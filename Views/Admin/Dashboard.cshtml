@model IEnumerable<Booking>
@{ ViewData["Title"]="Admin Dashboard"; }<h1>Admin Dashboard</h1><div class="stats"><div class="stat"><strong>@Model.Count()</strong><span>Total Bookings</span></div><div class="stat"><strong>@Model.Count(x=>x.Status=="Pending")</strong><span>Pending</span></div><div class="stat"><strong>@Model.Count(x=>x.PaymentStatus=="Paid")</strong><span>Paid</span></div></div><div class="grid three"><a class="card linkcard" href="/Admin/Bookings"><h3>Manage Bookings</h3></a><a class="card linkcard" href="/Admin/Services"><h3>Manage Services</h3></a><a class="card linkcard" href="/Admin/Customers"><h3>Customers</h3></a><a class="card linkcard" href="/Admin/Payments"><h3>Payments</h3></a><a class="card linkcard" href="/Admin/AssignStaff"><h3>Assign Staff</h3></a><a class="card linkcard" href="/Admin/Reports"><h3>Reports</h3></a></div>
