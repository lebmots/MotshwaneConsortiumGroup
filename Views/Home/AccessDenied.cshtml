@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="text-center mx-auto" style="max-width: 650px;">
        <h1 class="mb-3">Access Denied</h1>

        <p class="lead">
            You do not have permission to access this area of the
            Motshwane Consortium system.
        </p>

        <p class="text-muted">
            Please sign in with an account that has the required role.
        </p>

        <div class="mt-4">
            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-primary">
                Return Home
            </a>

            <a asp-controller="Customer"
               asp-action="Logout"
               class="btn btn-outline-secondary ms-2">
                Sign Out
            </a>
        </div>
    </div>
</div>





